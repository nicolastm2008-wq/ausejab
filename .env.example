# MongoDB
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/acueducto

# Sesion del panel privado (genera una cadena aleatoria larga)
AUTH_SECRET=cambia-este-valor-por-uno-aleatorio-y-largo

# Vercel Blob (almacenamiento de PDFs de informes DIAN)
BLOB_READ_WRITE_TOKEN=

# Usuario administrador inicial (solo se usa una vez, con "npm run seed")
ADMIN_EMAIL=admin@acueducto.local
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME="Administrador"
